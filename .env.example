# ── Runtime ────────────────────────────────────────────────────────────────
# Set to "production" in the deployed environment. This arms the guard that
# requires BETTER_AUTH_SECRET (the app refuses to boot without it in prod).
NODE_ENV=development
# Port the Node server listens on (default 5173).
PORT=5173

# ── Auth (better-auth) ──────────────────────────────────────────────────────
# REQUIRED in production. Generate with:  openssl rand -hex 32
BETTER_AUTH_SECRET=
# The app's public base URL, e.g. https://cruio.example.com. When set it is
# also added to the trusted origins automatically.
# BETTER_AUTH_URL=http://localhost:5173
# Extra trusted origins (comma-separated) beyond localhost + BETTER_AUTH_URL.
# Needed so better-auth accepts auth POSTs (e.g. accepting an invite) from them.
# APP_ORIGINS=https://cruio.example.com

# Extra hostnames the DEV server (vite) will accept, comma-separated. Only
# relevant for `vite dev` behind a tunnel — the built server ignores this.
# ALLOWED_HOSTS=my-tunnel.example.com

# ── AI assistant (optional) ─────────────────────────────────────────────────
# The assistant is disabled (503) unless ANTHROPIC_API_KEY or AI_BASE_URL is set.
#
# Which wire protocol to speak to the model server: "anthropic" (default) or
# "openai". Use "openai" to talk directly to an OpenAI-compatible server such as
# llama.cpp's llama-server (/v1/chat/completions) with no translation layer.
# AI_PROTOCOL=anthropic
#
# Real Anthropic API key (leave unset when pointing at a local/self-hosted model).
# ANTHROPIC_API_KEY=
#
# Base URL of a self-hosted / OpenAI-compatible model server. For llama.cpp
# reached over a Cloudflare tunnel, e.g. https://model.example.com
# AI_BASE_URL=http://localhost:8080
#
# Model id. Default "claude-opus-5"; set to whatever your server serves.
# AI_MODEL=claude-opus-5
#
# Reasoning effort (Anthropic path only): low | medium | high | xhigh | max
# AI_EFFORT=medium
